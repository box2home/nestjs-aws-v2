{
    "name": "nestjs-aws",
    "private": true,
    "version": "2.0.0",
    "description": "Nest TypeScript AWS Module repository",
    "author": "ABBES Mohamed Amine <abbesmohamedamine12@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/box2home/nestjs-aws"
    },
    "bugs": "https://github.com/box2home/nestjs-aws/issues",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "*.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "release": "npx -p @semantic-release/changelog -p @semantic-release/git@beta -p semantic-release@beta  semantic-release --no-ci",
        "commit": "npx git-cz",
        "start:dev": "tsc -w",
        "prebuild": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
        "build": "tsc -p tsconfig.build.json",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "prepare": "npm run build"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1154.0",
        "@aws-sdk/client-sns": "^3.1154.0",
        "@aws-sdk/s3-request-presigner": "^3.1154.0",
        "nodemailer": "^10.1.7",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^12.0.1",
        "@eslint/js": "^10.0.1",
        "@nestjs/common": "^12.2.0",
        "@nestjs/core": "^12.2.0",
        "@nestjs/testing": "^12.2.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.2",
        "@types/nodemailer": "^8.0.2",
        "cz-conventional-changelog": "^3.0.2",
        "eslint": "^10.13.0",
        "eslint-plugin-import-helpers": "^2.0.2",
        "globals": "^17.13.0",
        "husky": "^3.0.8",
        "jest": "^30.5.2",
        "lint-staged": "~8.2.0",
        "prettier": "^3.9.10",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "ts-jest": "^29.4.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "<rootDir>/../jest.transform.cjs",
                {
                    "tsconfig": {
                        "allowJs": true
                    },
                    "diagnostics": false
                }
            ]
        },
        "transformIgnorePatterns": [
            "/node_modules/(?!(@nestjs|file-type|strtok3|token-types|@tokenizer|uint8array-extras|@standard-schema)/)"
        ],
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "lint-staged": {
        "*.@(ts)": [
            "eslint --fix",
            "git add"
        ]
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog",
            "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true"
        }
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "peerDependencies": {
        "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "reflect-metadata": "^0.1.12 || ^0.2.0",
        "rxjs": "^7.1.0"
    },
    "peerDependenciesMeta": {
        "reflect-metadata": {
            "optional": true
        }
    }
}
